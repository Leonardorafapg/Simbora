{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "crm",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "crm",
        "run",
        "dev",
        "--",
        "-p",
        "3001"
      ],
      "port": 3001
    },
    {
      "name": "backend-ig",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "cd backend && python -m uvicorn app.main:app --port 8010"
      ],
      "port": 8010
    },
    {
      "name": "crm-ig",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set BACKEND_URL=http://127.0.0.1:8010&& set BUILD_VERIFY=1&& npm --prefix crm run dev -- -p 3011"
      ],
      "port": 3011
    },
    {
      "name": "backend-approval",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "cd /d C:\\Users\\Leonardo\\Desktop\\Simbora-approval-flow\\backend && python -m uvicorn app.main:app --port 8020"
      ],
      "port": 8020
    },
    {
      "name": "crm-approval",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set BACKEND_URL=http://127.0.0.1:8020&& cd /d C:\\Users\\Leonardo\\Desktop\\Simbora-approval-flow\\crm && npm run dev -- -p 3021"
      ],
      "port": 3021
    },
    {
      "name": "backend-dev",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "cd backend && python -m uvicorn app.main:app --port 8031"
      ],
      "port": 8031
    },
    {
      "name": "crm-dev",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set BACKEND_URL=http://127.0.0.1:8031&& npm --prefix crm run dev -- -p 3031"
      ],
      "port": 3031
    }
  ]
}