---
const links = [
  { label: "Serviços", href: "#servicos" },
  { label: "Cases", href: "#cases" },
  { label: "Sobre", href: "#sobre" },
];
---

<header id="navbar" class="absolute top-0 left-0 right-0 z-50">
  <nav class="mx-auto grid max-w-7xl grid-cols-3 items-center px-6 py-4 lg:px-10">
    <a href="#" class="flex items-center">
      <img src="/images/logo.png" alt="Simbora Maranhão" class="h-10 w-auto" />
    </a>

    <div class="hidden items-center justify-center gap- lg:flex">
      {links.map((link) => (
        <a
          href={link.href}
          class="font-body text-sm font-medium text-white transition-colors hover:text-cyan"
        >
          {link.label}
        </a>
      ))}
    </div>

    <div class="flex items-center justify-end">
      <a
        href="#cta"
        class="hidden rounded-full border border-cyan px-5 py-2 text-sm font-medium text-cyan transition-colors duration-300 hover:bg-cyan hover:text-black lg:inline-block"
      >
        Fale Conosco
      </a>

      <button
        id="menu-toggle"
        aria-label="Abrir menu"
        aria-expanded="false"
        class="flex flex-col gap-1.5 p-2 lg:hidden"
      >
        <span class="h-0.5 w-6 bg-white transition-transform"></span>
        <span class="h-0.5 w-6 bg-white transition-opacity"></span>
        <span class="h-0.5 w-6 bg-white transition-transform"></span>
      </button>
    </div>
  </nav>

  <div
    id="mobile-menu"
    class="hidden flex-col gap-4 bg-dark px-6 pb-6 pt-2 lg:hidden"
  >
    {links.map((link) => (
      <a
        href={link.href}
        class="font-body text-sm font-medium text-white transition-colors hover:text-cyan"
      >
        {link.label}
      </a>
    ))}
    <a
      href="#cta"
      class="w-fit rounded-full border border-cyan px-5 py-2 text-sm font-medium text-cyan transition-colors duration-300 hover:bg-cyan hover:text-black"
    >
      Fale Conosco
    </a>
  </div>
</header>

<script>
  const menuToggle = document.getElementById("menu-toggle");
  const mobileMenu = document.getElementById("mobile-menu");

  menuToggle?.addEventListener("click", () => {
    const isOpen = mobileMenu?.classList.toggle("flex");
    mobileMenu?.classList.toggle("hidden");
    menuToggle.setAttribute("aria-expanded", String(Boolean(isOpen)));
  });

  mobileMenu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      mobileMenu.classList.add("hidden");
      mobileMenu.classList.remove("flex");
      menuToggle?.setAttribute("aria-expanded", "false");
    });
  });
</script>
